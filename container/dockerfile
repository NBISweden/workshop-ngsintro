FROM ubuntu:24.04

ARG QUARTO_VERSION=1.10.18

ENV DEBIAN_FRONTEND=noninteractive \
    PIXI_HOME=/opt/pixi \
    PIXI_PROJECT_MANIFEST=/opt/ngsintro/pixi.toml \
    PATH=/opt/ngsintro/.pixi/envs/default/bin:/opt/pixi/bin:${PATH}

RUN rm -f /etc/dpkg/dpkg.cfg.d/excludes \
    && apt-get update \
    && apt-get install --no-install-recommends --yes \
        bash \
        ca-certificates \
        curl \
        git \
        less \
        man-db \
        manpages \
        nano \
        procps \
        tree \
        unzip \
        wget \
    && architecture="$(dpkg --print-architecture)" \
    && curl --fail --location --show-error \
        --output /tmp/quarto.deb \
        "https://github.com/quarto-dev/quarto-cli/releases/download/v${QUARTO_VERSION}/quarto-${QUARTO_VERSION}-linux-${architecture}.deb" \
    && apt-get install --no-install-recommends --yes /tmp/quarto.deb \
    && rm /tmp/quarto.deb \
    && curl --fail --location --show-error https://pixi.sh/install.sh | bash \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/ngsintro

COPY container/pixi.toml container/pixi.lock ./

RUN pixi install --locked --run-post-link-scripts \
    && pixi shell-hook --shell bash \
        --manifest-path /opt/ngsintro/pixi.toml \
        --locked > /etc/profile.d/pixi.sh \
    && printf '%s\n' \
        '[ -f /etc/profile.d/pixi.sh ] && source /etc/profile.d/pixi.sh' \
        >> /etc/bash.bashrc \
    && quarto --version \
    && pixi --version \
    && samtools --version \
    && pixi clean cache --yes

WORKDIR /work

CMD ["bash", "--login"]
