Bootstrap: docker
From: ubuntu:24.04

%arguments
    QUARTO_VERSION=1.10.18

%files
    pixi.toml /opt/ngsintro/pixi.toml
    pixi.lock /opt/ngsintro/pixi.lock

%post
    export DEBIAN_FRONTEND=noninteractive
    export PIXI_HOME=/opt/pixi
    export PATH="${PIXI_HOME}/bin:${PATH}"

    apt-get update
    apt-get install --no-install-recommends --yes \
        bash \
        ca-certificates \
        curl \
        git

    architecture="$(dpkg --print-architecture)"
    curl --fail --location --show-error \
        --output /tmp/quarto.deb \
        "https://github.com/quarto-dev/quarto-cli/releases/download/v{{ QUARTO_VERSION }}/quarto-{{ QUARTO_VERSION }}-linux-${architecture}.deb"
    apt-get install --no-install-recommends --yes /tmp/quarto.deb
    rm /tmp/quarto.deb

    curl --fail --location --show-error https://pixi.sh/install.sh | bash

    cd /opt/ngsintro
    pixi install --locked

    pixi shell-hook --shell bash \
        --manifest-path /opt/ngsintro/pixi.toml \
        --locked > /etc/profile.d/pixi.sh
    printf '%s\n' \
        '[ -f /etc/profile.d/pixi.sh ] && source /etc/profile.d/pixi.sh' \
        >> /etc/bash.bashrc

    rm -rf /var/lib/apt/lists/*

%environment
    export PIXI_HOME=/opt/pixi
    export PIXI_PROJECT_MANIFEST=/opt/ngsintro/pixi.toml
    export PATH="/opt/ngsintro/.pixi/envs/default/bin:${PIXI_HOME}/bin:${PATH}"
    export BASH_ENV=/etc/profile.d/pixi.sh
    export SINGULARITY_SHELL=/bin/bash

%runscript
    exec /bin/bash --login "$@"

%test
    quarto --version
    /opt/pixi/bin/pixi --version
    /opt/ngsintro/.pixi/envs/default/bin/samtools --version

%labels
    org.opencontainers.image.title workshop-ngsintro
    org.opencontainers.image.description "Quarto and the workshop-ngsintro Pixi environment"